START hilow_game

Print "Welcome to the Higher/Lower Game"

print "Enter lower bound"
    input lower_bound
print "Enter upper bound"
    input upper_bound
while lower_bound >= upper_bound
   print "Error: lower bound should be less than upper bound"
    print "enter lower bound"
        input lower_bound
    print "Enter upper bound"
        input upper_bound
end While

comp_num = Generate_Random(lowerbound, upperbound)

isGuessed = False

while isGuessed == False DO
    Print "Enter your Guess"
    input user_guess
while user_guess < lower_bound or user_guess > upper_bound DO
    print "Error: Your guess must be between (lower_bound, upper_bound)"
    input user_guess
end while

IF user_guess < comp_num THEN
    print "Guess too low. Please try again"
    input user_guess
elif user_guess > comp_num THEN
    print "Guess too high. Please try again"
    input user_guess
elif user_guess = = comp_num:  
    print "Congratulations, you are correct!!"

isGuessed = True

END hilow_game

